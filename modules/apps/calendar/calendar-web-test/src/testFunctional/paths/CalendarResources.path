<html>
<head>
<title>CalendarResources</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">CalendarResources</td></tr>
</thead>

<tbody>
<!--RESOURCE_TABLE-->
<tr>
	<td>RESOURCE_TABLE_NAME</td>
	<td>//tr[contains(.,'${key_calendarResourceName}')]/td[1]</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TABLE_DESCRIPTION</td>
	<td>//tr[contains(.,'${key_calendarResourceName}')]/td[2]</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TABLE_ACTIVE</td>
	<td>//tr[contains(.,'${key_calendarResourceName}')]/td[3]</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_TABLE_ACTIONS</td>
	<td>//tr[contains(.,'${key_calendarResourceName}')]/td[4]//a[span/*[name()='svg'][contains(@class,'icon-ellipsis-v')]]</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_FILTER_AND_ORDER_BUTTON_DROPDOWN</td>
	<td>//button[contains(@class, "dropdown-toggle nav-link btn btn-unstyled")]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_CREATED_RESOURCE_IS_ACTIVE</td>
	<td>//td[contains(text(),'${key}')]</td>
	<td></td>
</tr>
<tr>
	<td>RESOURCE_FILTER_AND_ORDER_OPTIONS</td>
	<td>//*[contains(@class, 'dropdown-item') and contains(text(),'${filterOption}')]</td>
	<td></td>
</tr>
<tr>
	<td>VIEW_RESOURCE_NAME_ON_TABLE</td>
	<td>//td[contains(text(),'${key_resourceName}')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>